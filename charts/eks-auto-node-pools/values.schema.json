{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "eks-auto-node-pools values",
  "description": "An unknown key is an error, not a silent no-op: a typo in a pool's key would otherwise render a pool that quietly lacks the setting.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's shared values. Unused by this chart; allowed so a parent chart can set it."
    },
    "clusterName": { "type": "string" },
    "subnetSelectorTags": { "$ref": "#/definitions/stringMap" },
    "podSubnetSelectorTags": { "$ref": "#/definitions/stringMap" },
    "protect": { "type": "boolean" },
    "poolDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expireAfter": { "$ref": "#/definitions/duration" },
        "terminationGracePeriod": { "$ref": "#/definitions/duration" },
        "consolidationPolicy": { "enum": ["WhenEmpty", "WhenEmptyOrUnderutilized"] },
        "consolidateAfter": { "$ref": "#/definitions/duration" }
      }
    },
    "classDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkPolicy": { "enum": ["DefaultAllow", "DefaultDeny"] },
        "networkPolicyEventLogs": { "enum": ["Enabled", "Disabled"] },
        "snatPolicy": { "enum": ["Random", "Disabled"] }
      }
    },
    "nodePools": {
      "type": "array",
      "items": { "$ref": "#/definitions/nodePool" }
    },
    "nodeClasses": {
      "type": "array",
      "items": { "$ref": "#/definitions/nodeClass" }
    }
  },
  "definitions": {
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "name": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$" },
    "duration": { "type": "string", "pattern": "^([0-9]+(h|m|s))+$" },
    "stringList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nodePool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "archs", "capacityTypes", "categories"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "archs": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["arm64", "amd64"] }
        },
        "capacityTypes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["on-demand", "spot"] }
        },
        "categories": { "$ref": "#/definitions/stringList" },
        "zones": { "$ref": "#/definitions/stringList" },
        "taints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "effect"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "value": { "type": "string" },
              "effect": { "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] }
            }
          }
        },
        "cpuLimit": { "type": "integer", "minimum": 1 },
        "maxInstanceCpu": { "type": "integer", "minimum": 1 },
        "expireAfter": { "$ref": "#/definitions/duration" },
        "terminationGracePeriod": { "$ref": "#/definitions/duration" },
        "consolidationPolicy": { "enum": ["WhenEmpty", "WhenEmptyOrUnderutilized"] },
        "fastEmptyReclaim": { "type": "boolean" },
        "nodeClassName": { "$ref": "#/definitions/name" },
        "nodeClass": { "$ref": "#/definitions/nodeClass" }
      }
    },
    "nodeClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "ephemeralStorage"],
      "properties": {
        "name": { "$ref": "#/definitions/name" },
        "role": { "type": "string", "minLength": 1 },
        "podSubnets": { "type": "boolean" },
        "ephemeralStorage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size", "iops", "throughput"],
          "properties": {
            "size": { "type": "string", "pattern": "^[0-9]+(Gi|Ti)$" },
            "iops": { "type": "integer", "minimum": 3000 },
            "throughput": { "type": "integer", "minimum": 125 }
          }
        }
      }
    }
  }
}
