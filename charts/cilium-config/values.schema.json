{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cilium-config values",
  "description": "An unknown key is an error, not a silent no-op: a misspelt selector or block would leave Services without an address and the rollout would look finished.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's shared values. Unused by this chart; allowed so a parent chart can set it."
    },
    "protect": {
      "type": "boolean"
    },
    "helmKeep": {
      "type": "boolean"
    },
    "loadBalancerIPPools": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
        "not": {
          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocks"
        ],
        "properties": {
          "blocks": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "cidr"
                  ],
                  "properties": {
                    "cidr": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$",
                      "not": {
                        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "start",
                    "stop"
                  ],
                  "properties": {
                    "start": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F:.]+$",
                      "not": {
                        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                      }
                    },
                    "stop": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F:.]+$",
                      "not": {
                        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "serviceSelector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matchLabels": {
                "$ref": "#/$defs/stringMap"
              },
              "matchExpressions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "operator"
                  ],
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operator": {
                      "enum": [
                        "In",
                        "NotIn",
                        "Exists",
                        "DoesNotExist"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "allowFirstLastIPs": {
            "type": "boolean"
          },
          "disabled": {
            "type": "boolean"
          },
          "syncWave": {
            "type": [
              "integer",
              "null"
            ]
          },
          "protect": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "annotations": {
            "$ref": "#/$defs/stringMap"
          }
        }
      }
    },
    "l2Announcements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "policies": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interfaces": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "nodeSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "$ref": "#/$defs/stringMap"
                  },
                  "matchExpressions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "operator"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "operator": {
                          "enum": [
                            "In",
                            "NotIn",
                            "Exists",
                            "DoesNotExist"
                          ]
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "serviceSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "$ref": "#/$defs/stringMap"
                  },
                  "matchExpressions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "key",
                        "operator"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1
                        },
                        "operator": {
                          "enum": [
                            "In",
                            "NotIn",
                            "Exists",
                            "DoesNotExist"
                          ]
                        },
                        "values": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "loadBalancerIPs": {
                "type": "boolean"
              },
              "externalIPs": {
                "type": "boolean"
              },
              "syncWave": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "protect": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "annotations": {
                "$ref": "#/$defs/stringMap"
              }
            }
          }
        }
      }
    },
    "bgp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clusterConfigs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec"
            ],
            "properties": {
              "spec": {
                "type": "object",
                "required": [
                  "bgpInstances"
                ],
                "properties": {
                  "nodeSelector": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "matchLabels": {
                        "$ref": "#/$defs/stringMap"
                      },
                      "matchExpressions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "key",
                            "operator"
                          ],
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1
                            },
                            "operator": {
                              "enum": [
                                "In",
                                "NotIn",
                                "Exists",
                                "DoesNotExist"
                              ]
                            },
                            "values": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "bgpInstances": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "localASN"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "localASN": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4294967295
                        },
                        "peers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "name"
                            ],
                            "properties": {
                              "name": {
                                "type": "string",
                                "minLength": 1
                              },
                              "peerASN": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 4294967295
                              },
                              "peerAddress": {
                                "type": "string"
                              },
                              "peerConfigRef": {
                                "type": "object",
                                "required": [
                                  "name"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "minItems": 1
                  }
                }
              },
              "syncWave": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "protect": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "annotations": {
                "$ref": "#/$defs/stringMap"
              }
            }
          }
        },
        "peerConfigs": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec"
            ],
            "properties": {
              "spec": {
                "type": "object"
              },
              "syncWave": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "protect": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "annotations": {
                "$ref": "#/$defs/stringMap"
              }
            }
          }
        },
        "advertisements": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec",
              "labels"
            ],
            "properties": {
              "spec": {
                "type": "object",
                "required": [
                  "advertisements"
                ],
                "properties": {
                  "advertisements": {
                    "type": "array",
                    "items": {},
                    "minItems": 1
                  }
                }
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "minProperties": 1
              },
              "syncWave": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "protect": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "annotations": {
                "$ref": "#/$defs/stringMap"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "objectName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
      "not": {
        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
