{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cluster-network-policies values",
  "description": "An unknown key is an error, not a silent no-op: a misspelt `egres` would otherwise render a policy that denies all egress instead of the rules meant.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's shared values. Unused by this chart; allowed so a parent chart can set it."
    },
    "protect": { "type": "boolean" },
    "helmKeep": { "type": "boolean" },
    "policies": {
      "type": "array",
      "items": { "$ref": "#/definitions/policy" }
    }
  },
  "definitions": {
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "objectName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$" },
    "annotationKey": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matchLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "matchExpressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "description": "NetworkPolicy ingress or egress rules, rendered verbatim. An empty rule ({}) allows everything in that direction.",
      "items": { "type": "object" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace", "reason", "podSelector", "policyTypes"],
      "properties": {
        "name": { "$ref": "#/definitions/objectName" },
        "namespace": { "$ref": "#/definitions/dnsLabel" },
        "reason": { "type": "string", "minLength": 10 },
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "policyTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["Ingress", "Egress"] }
        },
        "ingress": { "$ref": "#/definitions/rules" },
        "egress": { "$ref": "#/definitions/rules" },
        "syncWave": { "type": ["integer", "null"] },
        "protect": { "type": ["boolean", "null"] },
        "annotations": { "type": "object", "propertyNames": { "$ref": "#/definitions/annotationKey" }, "additionalProperties": { "type": "string" } }
      }
    }
  }
}
