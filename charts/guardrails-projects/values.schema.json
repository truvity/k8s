{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "guardrails-projects values",
  "description": "An unknown key is an error, not a silent no-op.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "namespaceName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "objectName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.:]{0,251}[a-z0-9])?$"
    },
    "quantityMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "from": {
          "type": "array"
        },
        "to": {
          "type": "array"
        },
        "ports": {
          "type": "array"
        }
      }
    },
    "policyRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verbs"
        ],
        "properties": {
          "apiGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nonResourceURLs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verbs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "User",
            "Group",
            "ServiceAccount"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "$ref": "#/definitions/namespaceName"
        }
      }
    },
    "level": {
      "enum": [
        "privileged",
        "baseline",
        "restricted"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "warn",
          "audit",
          "enforce"
        ]
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "helmKeep": {
      "type": "boolean"
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "modes"
      ],
      "properties": {
        "level": {
          "$ref": "#/definitions/level"
        },
        "version": {
          "type": "string",
          "pattern": "^(|latest|v1\\.[0-9]+)$"
        },
        "modes": {
          "$ref": "#/definitions/modes"
        },
        "reasonAnnotation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/objectName"
        },
        "intraNamespace": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rule"
          }
        }
      }
    },
    "quotas": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/objectName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hard"
        ],
        "properties": {
          "hard": {
            "$ref": "#/definitions/quantityMap"
          },
          "limitRange": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "default": {
                "$ref": "#/definitions/quantityMap"
              },
              "defaultRequest": {
                "$ref": "#/definitions/quantityMap"
              },
              "min": {
                "$ref": "#/definitions/quantityMap"
              },
              "max": {
                "$ref": "#/definitions/quantityMap"
              }
            }
          }
        }
      }
    },
    "quotaName": {
      "$ref": "#/definitions/objectName"
    },
    "limitRangeName": {
      "$ref": "#/definitions/objectName"
    },
    "clusterRoles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/objectName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules"
        ],
        "properties": {
          "aggregateTo": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "admin",
                "edit",
                "view"
              ]
            }
          },
          "rules": {
            "$ref": "#/definitions/policyRules"
          }
        }
      }
    },
    "ackRoleSelectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namePrefix": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?-?$"
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "$ref": "#/definitions/namespaceName"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 63
            }
          },
          "podSecurity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "level": {
                "$ref": "#/definitions/level"
              },
              "modes": {
                "$ref": "#/definitions/modes"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "quota": {
            "$ref": "#/definitions/objectName"
          },
          "deletable": {
            "type": "boolean"
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "$ref": "#/definitions/objectName"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rules"
              ],
              "properties": {
                "rules": {
                  "$ref": "#/definitions/policyRules"
                }
              }
            }
          },
          "roleBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "subjects"
              ],
              "properties": {
                "name": {
                  "$ref": "#/definitions/objectName"
                },
                "clusterRole": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "$ref": "#/definitions/objectName"
                },
                "subjects": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/subject"
                  }
                }
              }
            }
          },
          "ackRoleARN": {
            "type": "string",
            "pattern": "^arn:[a-z-]+:iam::[^:]*:role/.+$"
          },
          "podIdentities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/definitions/objectName"
            }
          }
        }
      }
    },
    "podIdentities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string"
        },
        "associations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/objectName"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleARN",
              "associationNamespace"
            ],
            "properties": {
              "roleARN": {
                "type": "string",
                "pattern": "^arn:[a-z-]+:iam::[^:]*:role/.+$"
              },
              "associationNamespace": {
                "$ref": "#/definitions/namespaceName"
              }
            }
          }
        }
      }
    }
  }
}
