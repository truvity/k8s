{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "guardrails-projects values",
  "description": "An unknown key is an error, not a silent no-op.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "helmKeep": {
      "type": "boolean"
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "modes"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "version": {
          "type": "string",
          "pattern": "^(|latest|v1\\.[0-9]+)$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "modes": {
          "$ref": "#/$defs/modes"
        },
        "reasonAnnotation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "intraNamespace": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "quotas": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9.:]{0,251}[a-z0-9])?$",
        "not": {
          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hard"
        ],
        "properties": {
          "hard": {
            "$ref": "#/$defs/quantityMap"
          },
          "limitRange": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "default",
                "defaultRequest",
                "min",
                "max"
              ]
            },
            "additionalProperties": {
              "$ref": "#/$defs/quantityMap"
            },
            "minProperties": 1
          }
        }
      }
    },
    "quotaName": {
      "$ref": "#/$defs/objectName"
    },
    "limitRangeName": {
      "$ref": "#/$defs/objectName"
    },
    "clusterRoles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9.:]{0,251}[a-z0-9])?$",
        "not": {
          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules"
        ],
        "properties": {
          "aggregateTo": {
            "type": "array",
            "items": {
              "enum": [
                "admin",
                "edit",
                "view"
              ]
            },
            "uniqueItems": true
          },
          "rules": {
            "$ref": "#/$defs/policyRules"
          }
        }
      }
    },
    "ackRoleSelectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namePrefix": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?-?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/namespaceName"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 63
            }
          },
          "podSecurity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "level": {
                "$ref": "#/$defs/level"
              },
              "modes": {
                "$ref": "#/$defs/modes"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "quota": {
            "$ref": "#/$defs/objectName"
          },
          "deletable": {
            "type": "boolean"
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]([-a-z0-9.:]{0,251}[a-z0-9])?$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rules"
              ],
              "properties": {
                "rules": {
                  "$ref": "#/$defs/policyRules"
                }
              }
            }
          },
          "roleBindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "subjects"
              ],
              "properties": {
                "name": {
                  "$ref": "#/$defs/objectName"
                },
                "clusterRole": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "$ref": "#/$defs/objectName"
                },
                "subjects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/subject"
                  },
                  "minItems": 1
                }
              }
            }
          },
          "ackRoleARN": {
            "type": "string",
            "pattern": "^arn:[a-z-]+:iam::[^:]*:role/.+$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "podIdentities": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/objectName"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "podIdentities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string"
        },
        "associations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9.:]{0,251}[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roleARN",
              "associationNamespace"
            ],
            "properties": {
              "roleARN": {
                "type": "string",
                "pattern": "^arn:[a-z-]+:iam::[^:]*:role/.+$",
                "not": {
                  "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                }
              },
              "associationNamespace": {
                "$ref": "#/$defs/namespaceName"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "level": {
      "enum": [
        "privileged",
        "baseline",
        "restricted"
      ]
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": [
          "warn",
          "audit",
          "enforce"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "objectName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.:]{0,251}[a-z0-9])?$",
      "not": {
        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "from": {
          "type": "array",
          "items": {}
        },
        "to": {
          "type": "array",
          "items": {}
        },
        "ports": {
          "type": "array",
          "items": {}
        }
      }
    },
    "quantityMap": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "number"
          }
        ]
      },
      "minProperties": 1
    },
    "policyRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verbs"
        ],
        "properties": {
          "apiGroups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resourceNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nonResourceURLs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verbs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    },
    "namespaceName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "not": {
        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "User",
            "Group",
            "ServiceAccount"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "$ref": "#/$defs/namespaceName"
        }
      }
    }
  }
}
