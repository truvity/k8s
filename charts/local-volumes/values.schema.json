{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "local-volumes values",
  "description": "An unknown key is an error, not a silent no-op: a misspelt node or claim would bind data to the wrong place.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": { "type": "object", "description": "Helm's shared values. Unused by this chart; allowed so a parent chart can set it." },
    "protect": { "type": "boolean" },
    "helmKeep": { "type": "boolean" },
    "pathPrefix": { "type": "string", "pattern": "^/.+/$" },
    "classMustExist": { "type": "boolean" },
    "storageClasses": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/objectName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "isDefault": { "type": "boolean" },
          "reclaimPolicy": { "enum": ["Retain", "Delete"] },
          "allowVolumeExpansion": { "type": "boolean" },
          "syncWave": { "$ref": "#/definitions/syncWave" },
          "protect": { "type": ["boolean", "null"] },
          "annotations": { "$ref": "#/definitions/stringMap" }
        }
      }
    },
    "volumes": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/objectName" },
      "additionalProperties": { "$ref": "#/definitions/volume" }
    }
  },
  "definitions": {
    "objectName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$" },
    "dnsLabel": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "syncWave": { "type": ["integer", "null"] },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClass", "node", "path", "capacity"],
      "properties": {
        "storageClass": { "$ref": "#/definitions/objectName" },
        "node": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$" },
        "path": { "type": "string", "pattern": "^/[^\\s]*[^/\\s]$" },
        "capacity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$" },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name"],
          "properties": {
            "namespace": { "$ref": "#/definitions/dnsLabel" },
            "name": { "$ref": "#/definitions/objectName" }
          }
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadOnlyMany"] }
        },
        "volumeMode": { "enum": ["Filesystem", "Block"] },
        "reclaimPolicy": { "enum": ["Retain", "Delete"] },
        "syncWave": { "$ref": "#/definitions/syncWave" },
        "protect": { "type": ["boolean", "null"] },
        "annotations": { "$ref": "#/definitions/stringMap" }
      }
    }
  }
}
