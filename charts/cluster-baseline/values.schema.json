{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cluster-baseline values",
  "description": "An unknown key is an error, not a silent no-op: a typo in a mode name would otherwise leave a namespace unlabelled and the rollout would look finished.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's shared values. Unused by this chart; allowed so a parent chart can set it."
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "privileged",
            "baseline",
            "restricted"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(|latest|v1\\.[0-9]+)$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warn": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "level": {
                  "enum": [
                    "",
                    "privileged",
                    "baseline",
                    "restricted"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^(|latest|v1\\.[0-9]+)$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                }
              }
            },
            "audit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "level": {
                  "enum": [
                    "",
                    "privileged",
                    "baseline",
                    "restricted"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^(|latest|v1\\.[0-9]+)$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                }
              }
            },
            "enforce": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "level": {
                  "enum": [
                    "",
                    "privileged",
                    "baseline",
                    "restricted"
                  ]
                },
                "version": {
                  "type": "string",
                  "pattern": "^(|latest|v1\\.[0-9]+)$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                }
              }
            }
          }
        },
        "namespaces": {
          "type": "object",
          "propertyNames": {
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "labels": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 63
                },
                "description": "Labels the Namespace object carries beside the Pod Security ones (which the chart refuses here)."
              },
              "level": {
                "enum": [
                  "privileged",
                  "baseline",
                  "restricted"
                ]
              },
              "version": {
                "type": "string",
                "pattern": "^(|latest|v1\\.[0-9]+)$",
                "not": {
                  "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "modes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "warn": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "description": "false: this namespace carries no label of this kind (needs a reason when the mode is on)."
                      },
                      "level": {
                        "enum": [
                          "privileged",
                          "baseline",
                          "restricted"
                        ]
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^(|latest|v1\\.[0-9]+)$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    }
                  },
                  "audit": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "description": "false: this namespace carries no label of this kind (needs a reason when the mode is on)."
                      },
                      "level": {
                        "enum": [
                          "privileged",
                          "baseline",
                          "restricted"
                        ]
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^(|latest|v1\\.[0-9]+)$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    }
                  },
                  "enforce": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "description": "false: this namespace carries no label of this kind (needs a reason when the mode is on)."
                      },
                      "level": {
                        "enum": [
                          "privileged",
                          "baseline",
                          "restricted"
                        ]
                      },
                      "version": {
                        "type": "string",
                        "pattern": "^(|latest|v1\\.[0-9]+)$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "description": "Namespaces by name. The name must be a DNS label."
        }
      },
      "allOf": [
        {
          "allOf": [
            {
              "if": {
                "properties": {
                  "level": {
                    "const": "privileged"
                  }
                },
                "required": [
                  "level"
                ]
              },
              "then": {
                "properties": {
                  "namespaces": {
                    "additionalProperties": {
                      "if": {
                        "properties": {
                          "level": {
                            "not": {
                              "const": "privileged"
                            }
                          }
                        },
                        "required": [
                          "level"
                        ]
                      },
                      "then": {
                        "required": [
                          "reason"
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "level": {
                    "const": "baseline"
                  }
                },
                "required": [
                  "level"
                ]
              },
              "then": {
                "properties": {
                  "namespaces": {
                    "additionalProperties": {
                      "if": {
                        "properties": {
                          "level": {
                            "not": {
                              "const": "baseline"
                            }
                          }
                        },
                        "required": [
                          "level"
                        ]
                      },
                      "then": {
                        "required": [
                          "reason"
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "level": {
                    "const": "restricted"
                  }
                },
                "required": [
                  "level"
                ]
              },
              "then": {
                "properties": {
                  "namespaces": {
                    "additionalProperties": {
                      "if": {
                        "properties": {
                          "level": {
                            "not": {
                              "const": "restricted"
                            }
                          }
                        },
                        "required": [
                          "level"
                        ]
                      },
                      "then": {
                        "required": [
                          "reason"
                        ]
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "protect": {
      "type": "boolean"
    },
    "reasonAnnotation": {
      "type": "string",
      "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
      "not": {
        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "validationActions": {
          "type": "array",
          "items": {
            "enum": [
              "Warn",
              "Audit",
              "Deny"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "failurePolicy": {
          "enum": [
            "Ignore",
            "Fail"
          ]
        },
        "satisfiedBy": {
          "type": "array",
          "items": {
            "enum": [
              "warn",
              "audit",
              "enforce"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "excludeNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        },
        "excludeNamePrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61})?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        },
        "namespaceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "matchExpressions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "operator"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "operator": {
                    "enum": [
                      "In",
                      "NotIn",
                      "Exists",
                      "DoesNotExist"
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "description": "A ValidatingAdmissionPolicy and its binding that warn when a Namespace is created, or updated to drop its labels, with no Pod Security label."
    },
    "labelGuard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "validationActions": {
          "type": "array",
          "items": {
            "enum": [
              "Warn",
              "Audit",
              "Deny"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "failurePolicy": {
          "enum": [
            "Ignore",
            "Fail"
          ]
        },
        "protectedPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        },
        "protectedDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)+$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        },
        "allowedUsers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^'\"\\\\]+$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        },
        "allowedUserPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^'\"\\\\]+$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        },
        "allowedGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[^'\"\\\\]+$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "uniqueItems": true
        }
      },
      "description": "A ValidatingAdmissionPolicy and its binding that let only the named principals set, change or remove the protected namespace labels."
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "protect": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              }
            },
            "podLabelKey": {
              "type": "string",
              "minLength": 1
            },
            "podLabelValue": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "namespaces": {
          "type": "object",
          "propertyNames": {
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deny"
            ],
            "properties": {
              "intraNamespace": {
                "type": "boolean",
                "description": "Let the namespace's own pods through, each denied direction."
              },
              "ingress": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "description"
                  ],
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "array",
                      "items": {}
                    },
                    "to": {
                      "type": "array",
                      "items": {}
                    },
                    "ports": {
                      "type": "array",
                      "items": {}
                    }
                  }
                }
              },
              "egress": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "description"
                  ],
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "from": {
                      "type": "array",
                      "items": {}
                    },
                    "to": {
                      "type": "array",
                      "items": {}
                    },
                    "ports": {
                      "type": "array",
                      "items": {}
                    }
                  }
                }
              },
              "name": {
                "$ref": "#/$defs/objectName"
              },
              "protect": {
                "type": "boolean",
                "description": "Overrides the kind's protect default for this object."
              },
              "deny": {
                "type": "array",
                "items": {
                  "enum": [
                    "ingress",
                    "egress"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "dnsEgress": {
                "type": "boolean",
                "description": "Required when egress is denied: true adds a DNS allow, false is a deliberate total egress deny."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "deny": {
                      "type": "array",
                      "contains": {
                        "enum": [
                          "egress"
                        ]
                      }
                    }
                  },
                  "required": [
                    "deny"
                  ]
                },
                "then": {
                  "required": [
                    "dnsEgress"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "deny": {
                      "type": "array",
                      "contains": {
                        "enum": [
                          "egress"
                        ]
                      }
                    }
                  },
                  "required": [
                    "deny"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "dnsEgress"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "protect": {
          "type": "boolean"
        },
        "reasonAnnotation": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "ownerAnnotation": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "namespaces": {
          "type": "object",
          "propertyNames": {
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hard"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/objectName"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "protect": {
                "type": "boolean",
                "description": "Overrides the kind's protect default for this object."
              },
              "hard": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z0-9][-A-Za-z0-9_./]*$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|[numkMGTPE]|[eE][0-9]+)?$",
                      "not": {
                        "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                      }
                    }
                  ]
                },
                "minProperties": 1
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "reason"
                    ]
                  },
                  {
                    "required": [
                      "owner"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "limitRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/objectName"
        },
        "protect": {
          "type": "boolean"
        },
        "reasonAnnotation": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "ownerAnnotation": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "namespaces": {
          "type": "object",
          "propertyNames": {
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "container"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/objectName"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "protect": {
                "type": "boolean",
                "description": "Overrides the kind's protect default for this object."
              },
              "container": {
                "type": "object",
                "propertyNames": {
                  "enum": [
                    "default",
                    "defaultRequest",
                    "min",
                    "max"
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9][-A-Za-z0-9_./]*$",
                    "not": {
                      "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                    }
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|[numkMGTPE]|[eE][0-9]+)?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    ]
                  },
                  "minProperties": 1
                },
                "minProperties": 1,
                "description": "At least one of the four kinds."
              }
            },
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "reason"
                    ]
                  },
                  {
                    "required": [
                      "owner"
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protect": {
          "type": "boolean"
        },
        "clusterRoles": {
          "type": "object",
          "propertyNames": {
