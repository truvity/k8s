{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tenancy values",
  "description": "An unknown key is an error, not a silent no-op: a typo in `protect` or in a feature name would otherwise leave a tenant unprotected or without a policy and the rollout would look finished.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm's shared values. Unused by this chart; allowed so a parent chart can set it."
    },
    "protect": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "enum": [
            "prune-only"
          ]
        }
      ]
    },
    "helmKeep": {
      "type": "boolean"
    },
    "syncWaves": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterRoles": {
          "type": [
            "integer",
            "null"
          ]
        },
        "networkPolicy": {
          "type": [
            "integer",
            "null"
          ]
        },
        "quota": {
          "type": [
            "integer",
            "null"
          ]
        },
        "rbac": {
          "type": [
            "integer",
            "null"
          ]
        },
        "nats": {
          "type": [
            "integer",
            "null"
          ]
        },
        "podIdentities": {
          "type": [
            "integer",
            "null"
          ]
        },
        "namespaces": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "",
            "privileged",
            "baseline",
            "restricted"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(|latest|v[0-9]+\\.[0-9]+)$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "warn",
              "audit",
              "enforce"
            ]
          },
          "uniqueItems": true
        },
        "unenforced": {
          "type": "boolean",
          "description": "Says on purpose that the default modes have no enforce."
        },
        "reasonAnnotation": {
          "type": "string"
        }
      },
      "description": "The Pod Security labels of the Namespaces this chart renders: required once a tenant asks for one."
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "not": {
          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default": {
                "$ref": "#/$defs/stringMap"
              },
              "networkPolicy": {
                "$ref": "#/$defs/stringMap"
              },
              "quota": {
                "$ref": "#/$defs/stringMap"
              },
              "rbac": {
                "$ref": "#/$defs/stringMap"
              },
              "nats": {
                "$ref": "#/$defs/stringMap"
              },
              "podIdentities": {
                "$ref": "#/$defs/stringMap"
              },
              "namespace": {
                "$ref": "#/$defs/stringMap"
              }
            }
          },
          "networkPolicy": {
            "type": "boolean"
          },
          "protect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "networkPolicy": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              },
              "quota": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              },
              "rbac": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              },
              "nats": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              },
              "podIdentities": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              },
              "namespace": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              }
            }
          },
          "namespace": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "level": {
                "enum": [
                  "privileged",
                  "baseline",
                  "restricted"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "modes": {
                "type": "array",
                "items": {
                  "enum": [
                    "warn",
                    "audit",
                    "enforce"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "unenforced": {
                "type": "boolean",
                "description": "Says on purpose that this namespace's modes have no enforce (a warn-first rollout)."
              },
              "syncWave": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "protect": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "enum": [
                      "prune-only"
                    ]
                  }
                ]
              },
              "annotations": {
                "$ref": "#/$defs/stringMap"
              }
            }
          },
          "quota": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "hard"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/objectName"
              },
              "hard": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|Pi|Ei|M|G|T|P|E)?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "minProperties": 1
              }
            }
          },
          "limitRange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "limits"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/objectName"
              },
              "limits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "Container",
                        "Pod",
                        "PersistentVolumeClaim"
                      ]
                    },
                    "default": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|Pi|Ei|M|G|T|P|E)?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    },
                    "defaultRequest": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|Pi|Ei|M|G|T|P|E)?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    },
                    "min": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|Pi|Ei|M|G|T|P|E)?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    },
                    "max": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|Pi|Ei|M|G|T|P|E)?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    },
                    "maxLimitRequestRatio": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|Ki|Mi|Gi|Ti|Pi|Ei|M|G|T|P|E)?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?)?$",
          "not": {
            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
          }
        },
        "intraNamespace": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "from": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "podSelector": {
                      "type": "object"
                    },
                    "namespaceSelector": {
                      "type": "object"
                    },
                    "ipBlock": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "cidr"
                      ],
                      "properties": {
                        "cidr": {
                          "type": "string",
                          "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$",
                          "not": {
                            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                          }
                        },
                        "except": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$",
                            "not": {
                              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "minItems": 1
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "port"
                  ],
                  "properties": {
                    "port": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "endPort": {
                      "type": "integer"
                    },
                    "protocol": {
                      "enum": [
                        "TCP",
                        "UDP",
                        "SCTP"
                      ]
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                  "not": {
                    "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                  }
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "podSelector": {
                      "type": "object"
                    },
                    "namespaceSelector": {
                      "type": "object"
                    },
                    "ipBlock": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "cidr"
                      ],
                      "properties": {
                        "cidr": {
                          "type": "string",
                          "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$",
                          "not": {
                            "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                          }
                        },
                        "except": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$",
                            "not": {
                              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "minItems": 1
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "port"
                  ],
                  "properties": {
                    "port": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "endPort": {
                      "type": "integer"
                    },
                    "protocol": {
                      "enum": [
                        "TCP",
                        "UDP",
                        "SCTP"
                      ]
                    }
                  }
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "tenants": {
      "type": "object",
      "propertyNames": {
        "maxLength": 63,
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "not": {
          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "labels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "default": {
                "$ref": "#/$defs/stringMap"
              },
              "networkPolicy": {
                "$ref": "#/$defs/stringMap"
              },
              "quota": {
                "$ref": "#/$defs/stringMap"
              },
              "rbac": {
                "$ref": "#/$defs/stringMap"
              },
              "nats": {
                "$ref": "#/$defs/stringMap"
              },
              "podIdentities": {
                "$ref": "#/$defs/stringMap"
              },
              "namespace": {
                "$ref": "#/$defs/stringMap"
              }
            }
          },
          "namespace": {
            "anyOf": [
              {
                "const": false
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "enum": [
                      "privileged",
                      "baseline",
                      "restricted"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "modes": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "warn",
                        "audit",
                        "enforce"
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "unenforced": {
                    "type": "boolean",
                    "description": "Says on purpose that this namespace's modes have no enforce (a warn-first rollout)."
                  },
                  "syncWave": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "protect": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "enum": [
                          "prune-only"
                        ]
                      }
                    ]
                  },
                  "annotations": {
                    "$ref": "#/$defs/stringMap"
                  }
                }
              }
            ],
            "description": "false: the namespace is someone else's; a map: this tenant's Namespace, merged over the profile's."
          },
          "nats": {
            "type": "boolean"
          },
          "podIdentities": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/objectName"
            },
            "uniqueItems": true
          },
          "roles": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rules"
              ],
              "properties": {
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "apiGroups",
                      "resources",
                      "verbs"
                    ],
                    "properties": {
                      "apiGroups": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "resources": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      },
                      "resourceNames": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "verbs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1
                      }
                    }
                  },
                  "minItems": 1
                },
                "labels": {
                  "$ref": "#/$defs/stringMap"
                },
                "protect": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "prune-only"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "roleBindings": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
              "not": {
                "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subjects"
              ],
              "properties": {
                "clusterRole": {
                  "$ref": "#/$defs/objectName"
                },
                "role": {
                  "$ref": "#/$defs/objectName"
                },
                "subjects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "name"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "Group",
                          "User",
                          "ServiceAccount"
                        ]
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "namespace": {
                        "type": "string",
                        "maxLength": 63,
                        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
                        "not": {
                          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
                        }
                      }
                    }
                  },
                  "minItems": 1
                },
                "labels": {
                  "$ref": "#/$defs/stringMap"
                },
                "protect": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "prune-only"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "description": "Tenants by namespace name. The name must be a DNS label."
    },
    "clusterRoles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
        "not": {
          "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules"
        ],
        "properties": {
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "apiGroups",
                "resources",
                "verbs"
              ],
              "properties": {
                "apiGroups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "resourceNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "verbs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          },
          "aggregateTo": {
            "type": "array",
            "items": {
              "enum": [
                "admin",
                "edit",
                "view"
              ]
            },
            "uniqueItems": true
          },
          "labels": {
            "$ref": "#/$defs/stringMap"
          },
          "syncWave": {
            "type": [
              "integer",
              "null"
            ]
          },
          "protect": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "enum": [
                  "prune-only"
                ]
              }
            ]
          }
        }
      }
    },
    "nats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(nats|tls)://.+",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          }
        },
        "serviceAccount": {
          "$ref": "#/$defs/objectName"
        },
        "tokenSecret": {
          "$ref": "#/$defs/objectName"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podIdentities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clusterName": {
          "type": "string"
        },
        "associations": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$",
            "not": {
              "pattern": "[\\n\\r\\f\\x0B\\x85\u2028\u2029]"
            }
          },
          "additionalProperties": {
